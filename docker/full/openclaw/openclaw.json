{
  "plugins": {
    "allow": ["qa-channel", "memory-core", "openclaw-bridge"],
    "entries": {
      "qa-channel": { "enabled": true },
      "memory-core": { "enabled": true },
      "openclaw-bridge": { "enabled": true }
    }
  },
  "channels": {
    "qa-channel": {
      "enabled": true,
      "baseUrl": "http://qa-bus:15000",
      "botUserId": "openclaw",
      "botDisplayName": "OpenClaw Bridge",
      "pollTimeoutMs": 250
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/tmp/openclaw/workspace",
      "model": {
        "primary": "fake-openai/fake-model"
      },
      "models": {
        "fake-openai/fake-model": {
          "params": {
            "transport": "sse",
            "openaiWsWarmup": false
          }
        }
      }
    },
    "list": [
      {
        "id": "bridge",
        "default": true,
        "identity": {
          "name": "BridgeBot",
          "theme": "SillyTavern Character Bridge Agent",
          "emoji": "🌉"
        }
      }
    ]
  },
  "memory": {
    "backend": "builtin"
  },
  "models": {
    "mode": "replace",
    "providers": {
      "fake-openai": {
        "baseUrl": "http://fake-openai:11436/v1",
        "apiKey": "test",
        "api": "openai-completions",
        "request": {
          "allowPrivateNetwork": true
        },
        "models": [
          {
            "id": "fake-model",
            "name": "fake-model",
            "api": "openai-completions",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 4096
          }
        ]
      }
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "e2e-full-oc-token"
    },
    "controlUi": {
      "enabled": false
    },
    "reload": {
      "deferralTimeoutMs": 1000
    }
  },
  "discovery": {
    "mdns": { "mode": "off" }
  }
}
